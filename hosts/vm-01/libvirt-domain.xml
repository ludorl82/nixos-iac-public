<!--
  Canonical libvirt domain definition for the vm-01 VM, which runs on
  `gpu-01`. Restore with:  virsh define hosts/vm-01/libvirt-domain.xml

  Domains here are created imperatively with virt-install (see
  gpu-01/configuration.nix), so nothing about the VM's hardware is otherwise
  in git. Two settings on the <interface> elements must not be lost - both
  were lost once on vm-02 during its rebuild and cost a full rediscovery:

    trustGuestRxFilters='yes'   - without it, macvtap never learns the
                                  guest's solicited-node multicast group,
                                  so inbound NDP for the VM's IPv6 address
                                  is silently dropped.
    <model type='virtio'/>      - REQUIRED for the above to do anything.
                                  trustGuestRxFilters only works if the NIC
                                  model reports the guest's RX filter
                                  changes to the host; virtio-net does, the
                                  e1000 emulation does NOT. The e1000
                                  symptom is deceptive: outbound IPv6 is
                                  fine, replies to guest-initiated traffic
                                  are fine, and only cold inbound NDP fails
                                  (neighbour stuck INCOMPLETE), so a warm
                                  neighbour cache hides it completely.

  Either change needs a full stop/start (virsh shutdown + virsh start), not
  a guest reboot, before the NIC re-attaches with the new attributes.

  net0 = tagged VLAN10 (parent `vlan10`) - primary, carries the default route.
  net1 = untagged VLAN50 (parent `eno2`) - secondary, address only, no gateway.

  Related: gpu-01 puts its OWN VLAN10 address on a `mvhost` macvlan over
  vlan10, because a macvtap guest cannot reach the host stack on its own
  parent - without that, flannel traffic between gpu-01 and vm-01 is dropped.

  Keep this in sync by hand after any `virsh edit`, by dumping the inactive
  config on gpu-01:
    ssh gpu-01 sudo virsh dumpxml [dash][dash]inactive vm-01
  (spelled out because a literal double hyphen is illegal inside an XML
  comment - it makes this very file fail to parse, which defeats the point
  of it being the recovery artifact.)
-->
<domain type='kvm'>
  <name>vm-01</name>
  <uuid>00000000-0000-0000-0000-000000000000</uuid>
  <memory unit='KiB'>4194304</memory>
  <currentMemory unit='KiB'>4194304</currentMemory>
  <vcpu placement='static'>4</vcpu>
  <resource>
    <partition>/machine</partition>
  </resource>
  <os firmware='efi'>
    <type arch='x86_64' machine='pc-i440fx-11.0'>hvm</type>
    <firmware>
      <feature enabled='no' name='enrolled-keys'/>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <loader readonly='yes' type='pflash' format='raw'>/run/libvirt/nix-ovmf/edk2-x86_64-code.fd</loader>
    <nvram template='/run/libvirt/nix-ovmf/edk2-i386-vars.fd' templateFormat='raw' format='raw'>/var/lib/libvirt/qemu/nvram/vm-01_VARS.fd</nvram>
    <boot dev='cdrom'/>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='custom' match='exact' check='full'>
    <model fallback='forbid'>Skylake-Server-IBRS</model>
    <vendor>Intel</vendor>
    <feature policy='require' name='vmx'/>
    <feature policy='disable' name='pdcm'/>
    <feature policy='require' name='hypervisor'/>
