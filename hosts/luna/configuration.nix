## NixOS config for stella — Supermicro X11SRA-RF, same board as bob.
## Converted from Windows 11 + Hyper-V (see net-cfgs/history.md).
##
## ROLE: gaming host AND an on-demand k3s node, a GPU one again since
## 2026-10-08. The gaming guests (arcade1 on a GTX 1650, arcade2 on a GTX 1660)
## run
## as libvirt VMs here, but gaming is rare and exclusive — so rather than let a
## 6-core/46 GB Xeon sit idle 99% of the time, stella ALSO joins the k3s
## cluster and does cluster work whenever nobody is playing.
##
## HOW THE TWO ROLES COEXIST (revised 2026-08-17 — this host used to be
## deliberately NOT a k3s node): the arcade VMs do NOT autostart. Starting them
## goes through a "game mode" flow (a Home Assistant button / the game-mode
## script) that CORDONS stella, so no NEW pod lands here during a session, and
## UNCORDONS when the VM shuts down. Pods already running stay put.
## Until 2026-10-15 it also DRAINED stella (16 GB guests, then 12 GB): no
## more. The arcades are 8 GB each since that day (Civ VII, 1080p low), so
## both arcades + win11 (12) + worker5 (4) = 32 of 46 GB, leaving ~12 GB for
## the host and its pods — and a drain would evict Frigate once it lives here.
## The scheduler is NOT told to avoid this node (no taint) — a taint would
## only waste the idle capacity.
##
## THREE CARDS since 2026-10-08, all NVIDIA. The RTX 3050 8GB (GA106,
## b4:00.0) is the HOST's again: driven here on `production`, offered to k3s
## with gpu=nvidia. The guests got their own cards the same day: a GTX 1650
## (TU116, 17:00.0) for arcade1 and a GTX 1660 (TU116, 65:00.0) for arcade2,
## both vfio-bound with all four functions of each (GPU, audio, USB, UCSI).
## The GTX 960 left. win11 runs without a card, always on, on bob or here.
## The host's screen is the onboard ASPEED VGA (03:00.0), the same output the
## BMC's iKVM captures. (From 2026-10-04 to 10-08 the host had no NVIDIA card:
## the 8GB was arcade1's, and the 6GB had left for vega.)
##
## A driver on THIS kernel deadlocked it once — 2026-09-14, the GTX 960 for
## k3s. The GPU block further down keeps that post-mortem; it is the reason
## this host has a serial GRUB menu, and it is worth reading before touching
## anything here.
##
## hardware-configuration.nix is generated by nixos-anywhere on the booted
## installer and imported here. Omitting it (initrd storage modules) is
## what made vega's first install unbootable.
{ config, lib, pkgs, ... }:
let
  # Locked-down entrypoint for Home Assistant to turn the gaming VMs on/off.
  # HA's forced-command SSH key can ONLY run this — it reads the fixed command
  # from $SSH_ORIGINAL_COMMAND and permits nothing but start/stop/status of the
  # two arcade VMs. ludorl82 is in the libvirtd group, so `virsh` needs no sudo.
  # win11 left this list on 2026-10-08: it no longer borrows arcade1's card,
  # it is always on and may live on bob (modules/vm-host.nix).
  # stop uses --mode agent because the guest's GNOME ignores the ACPI power
  # button; the qemu-guest-agent runs a clean poweroff instead.
  arcadeCtl = pkgs.writeShellScript "arcade-ctl" ''
    # /run/wrappers/bin FIRST: that is where NixOS keeps the only setuid sudo.
    # Putting /run/current-system/sw/bin ahead of it shadowed it with the
    # store's non-setuid sudo — "must be owned by uid 0 and have the setuid
    # bit set" — and the worker5 drain silently failed again (2026-09-15).
    export PATH=/run/wrappers/bin:/run/current-system/sw/bin:$PATH
    V="virsh -c qemu:///system"
    set -- $SSH_ORIGINAL_COMMAND
    action="$1"; vm="$2"
    case "$vm" in arcade1|arcade2) ;; *) echo "denied: bad vm"; exit 1 ;; esac

    case "$action" in
      start) exec $V start "$vm" ;;
      stop)
        # PATIENT on purpose. The shutdown goes through the qemu guest agent
        # (the desktop ignores ACPI), and the agent takes ~30-60s to come up
        # inside a freshly started guest — a stop sent right after a start
        # used to fail immediately with "guest agent is not connected"
        # (2026-09-15). So: idempotent if already off, then wait up to 90s for
        # the agent before asking. If the agent still is not there, say so and
        # let the caller retry — deliberately NOT falling back to destroy: a
        # hard kill mid-boot is how arcade2's card once ended up in D3cold.
        $V domstate "$vm" 2>/dev/null | grep -q running \
          || { echo "$vm is not running, nothing to stop"; exit 0; }
        for _ in $(seq 30); do
          $V qemu-agent-command "$vm" '{"execute":"guest-ping"}' >/dev/null 2>&1 && break
          sleep 3
        done
        if ! $V shutdown --mode agent "$vm"; then
          echo "guest agent still not up after 90s — $vm is likely mid-boot; retry in a minute"
          exit 1
        fi
        ;;
      status) exec $V domstate "$vm" ;;
      *) echo "denied: bad action"; exit 1 ;;
    esac
  '';
in
{
  imports = [
    ./hardware-configuration.nix
    ../../modules/private-ca.nix
    # On-demand k3s agent (see the header). Contributes CPU/RAM to the cluster
    # while the arcade VMs are shut down; cordoned (not drained) during one.
    ../../modules/k3s-agent.nix
    # Frigate's host side (firewall, low-res feed, cron, aws pull key) since
    # 2026-10-17; the pod is pinned here by k3s-iac frigate/ nodeSelector.
    ../../modules/frigate-host.nix
    # Replaces the old PowerShell NUT client at C:\Scripts\nut-monitor.ps1.
    # stella is on the rolling rack's CyberPower LX1500GU, whose USB cable
    # goes into bob — so stella is an upsmon SECONDARY of bob, exactly like
    # encodeur and vega. POST-INSTALL STEP: seed
    # /var/lib/nut/monclient-password byte-identically to bob's copy, or
    # upsmon refuses to start (which is the failure mode we want).
    ../../modules/ups-client.nix
    ../../modules/vm-host.nix
    ../../modules/caps-ctrl.nix
    ../../modules/kiosk-capture.nix
  ];

  # GRUB, not systemd-boot, and installed for BOTH firmware modes on purpose.
  # stella is being converted with its firmware stuck in legacy/CSM mode
  # (Load Optimized Defaults on 2026-08-17 flipped it, and BIOS Setup is
  # unreachable — GPU owns video, AMI Setup does not render over SOL). The
  # booted installer confirmed legacy (/sys/firmware/efi absent). Which mode
  # the firmware is in cannot be seen or changed remotely, so the installed
  # system must boot either way:
  #   - device set to the real disk → GRUB embeds core.img in the EF02
  #     bios_grub partition (disko-config.nix) for the legacy/CSM path;
  #   - efiSupport + efiInstallAsRemovable → GRUB also writes the UEFI loader
  #     to the ESP's removable fallback (EFI/BOOT/BOOTX64.EFI), which the
  #     firmware boots WITHOUT an NVRAM entry — important because NVRAM boot
  #     vars are unwritable from a legacy-booted installer (no efivars) and
  #     Load Optimized Defaults likely cleared them anyway.
  # canTouchEfiVariables MUST be false with efiInstallAsRemovable.
  # REVISIT once the firmware is put back to UEFI on a physical visit: this
  # can revert to plain systemd-boot like bob, though there is no need to.
  boot.loader.systemd-boot.enable = false;
  boot.loader.grub = {
    enable = true;
    efiSupport = true;
    efiInstallAsRemovable = true;
    device = "/dev/disk/by-id/nvme-EXAMPLE_NVME_0000000000000001";
    # Mirror the GRUB menu onto the BMC's SOL port (serial unit 1 = COM2, the
    # port the installer's POST output proved is bridged to SOL). Written when
    # the onboard VGA was off (jumper JPG1, until 2026-10-06) and the host had
    # no screen, so a failed boot could not be recovered without it. The
    # ASPEED and its iKVM show the menu now; SOL stays the second way to pick
    # the previous generation. --append keeps the graphical terminal too.
    extraConfig = ''
      serial --unit=1 --speed=115200 --word=8 --parity=no --stop=1
      terminal_input --append serial
      terminal_output --append serial
    '';
  };
  # Give the menu enough time to catch over a serial link before it auto-boots
  # the (default = newest) generation.
  boot.loader.timeout = lib.mkForce 8;
  boot.loader.efi.canTouchEfiVariables = false;
  boot.loader.efi.efiSysMountPoint = "/boot";

  # IOMMU + VFIO. Both slots verified to hold ONLY their card and that card's
  # audio function — clean isolation, no ACS override needed. Every address
  # and id below was READ OFF THE LIVE HOST, never guessed: an early comment
  # here guessed 2504 for the 3060 when it was really 2503, and the 3050 was
  # documented at 17:00.0 long after it had actually moved to b4:00.0.
  #
  #   0000:03:00.0  1a03:2000  ASPEED onboard VGA    -> THIS HOST [ast]
  #   0000:17:00.0  10de:2188  GTX 1650 (TU116)      -> arcade1   [vfio]
  #   0000:17:00.1  10de:1aeb  its HDMI audio                     [vfio]
  #   0000:17:00.2  10de:1aec  its USB 3.1 host controller        [vfio]
  #   0000:17:00.3  10de:1aed  its USB-C UCSI controller          [vfio]
  #   0000:65:00.0  10de:2184  GTX 1660 (TU116)      -> arcade2   [vfio]
  #   0000:65:00.1..3          same three functions, same ids     [vfio]
  #   0000:b4:00.0  10de:2507  RTX 3050 8GB (GA106)  -> THIS HOST [nvidia]
  #   0000:b4:00.1  10de:228e  its HDMI audio                     [snd_hda]
  #
  # 2026-10-08, read off the live host after the swap: IOMMU group 7 =
  # 17:00.0-.3, group 5 = 65:00.0-.3, group 3 = b4:00.0-.1, each holding only
  # its card. The two Turing cards share their three non-GPU ids (1aeb, 1aec,
  # 1aed): binding by id takes both, which is what both guests want.
  #
  # Read off the live host after the 2026-10-06 boot: the ASPEED (behind its
  # AST1150 bridge at 02:00.0) is boot_vga and the console's framebuffer
  # (astdrmfb). It had been missing from the bus since at least 2026-08-17 —
  # not a BIOS setting but jumper JPG1 sitting on 2-3 (disabled). With no
  # device to pick, "Onboard VGA" beeped in POST on 2026-10-04 and the Radeon
  # was brought in instead. On 2026-10-06 JPG1 went back to 1-2, the Radeon
  # came out and VGA Priority went back to Onboard. Removing it renumbered
  # nothing: 65:00 and b4:00 sit on other root ports, so no domain XML changed.
  #
  # Nobody borrows a card: win11 gave b4:00.x up on 2026-10-08 (no card,
  # always on, movable), worker5 was retired on 2026-09-26 (it borrowed both).
  #
  # Every group verified to hold ONLY that card and its audio function — group
  # 7 for 17:00.x, group 3 for b4:00.x, group 5 for 65:00.x — so each is safe
  # to pass through, and the one the host keeps is isolated just as cleanly.
  #
  # 2026-09-11: the RTX 3060 that used to sit at 65:00.0 (10de:2503 + audio
  # 228e) moved to bob as a third general-purpose GPU, and the GTX 960 took
  # its slot as a stopgap for arcade1.
  #
  # 2026-09-14: a second RTX 3050 went into 65:00.0 and the GTX 960 moved to
  # 17:00.0. Read off the live host, and the reading paid for itself: the two
  # 3050s are NOT the same part. arcade1's new card is a GA106 die reporting
  # 10de:2507, with a GA106 audio function — 228e, the same audio id the old
  # 3060 used, which is why 228e is back in the list. arcade2's card is a GA107
  # 6GB reporting 10de:2584. Assuming "a 3050 is a 3050" would have left 2584
  # alone in the list, bound arcade2's card twice over and arcade1's not at all.
  #
  # 2026-09-17: the guests were re-dealt and the host took a card. arcade1
  # moved from 65:00 to b4:00 (the GA107 6GB), arcade2 from b4:00 to 17:00
  # (the GTX 960), and 2507/228e came OUT of vfio-pci.ids so the GA106 could
  # be driven here for k3s. Nothing was unscrewed: the arcade domains address
  # a SLOT, so re-dealing cards between guests is an XML edit on each side,
  # and freeing a card for the host is an edit to the ids list. Those are two
  # different levers and the difference matters — moving a card between slots
  # does NOT free it, because vfio follows the id wherever the card sits.
  #
  # 2026-10-04: the GA107 6GB left for vega, the GA106 8GB moved into its
  # slot (b4:00). The GTX 960 went up to 65:00 and the passive Radeon HD 5450
  # took 17:00 between the two NVIDIA cards, for the host's screen and for
  # air: in the old order the 960's fans faced the 3050's back with no gap.
  # arcade1 and win11 address b4:00 and did not change; arcade2 moved from
  # 0x17 to 0x65 (hosts/arcade2/libvirt-domain.xml, re-defined by hand). The
  # ids changed too — 2584/2291 out, 2507/228e back in. Groups re-read the
  # same day: 7 = 17:00.x (Radeon), 5 = 65:00.x (960), 3 = b4:00.x (3050),
  # each holding only the card and its audio function. 17:00 is empty since
  # 2026-10-06; groups re-read then: 31 = 02:00.0 + 03:00.0 (ASPEED and its
  # bridge), 5 = 65:00.x, 3 = b4:00.x, unchanged.
  #
  # The GTX 960 spent one day (2026-09-14) meant for the host so k3s could
  # schedule on it; that is the attempt that deadlocked the kernel. It is a
  # guest card again, and the host keeps no GPU of its own.
  #
  # vfio-pci.ids binds EIGHT functions at initrd time — the two Turing guest
  # cards and their audio, USB and UCSI functions (vfio_pci is in
  # boot.initrd.kernelModules below), so nothing on the host ever touches
  # them. The host's RTX 3050 is left for the nvidia module (2026-10-08).
  # This list is LOAD-BEARING again since 2026-10-08. With no NVIDIA driver on
  # the host (10-04 to 10-08) it was belt-and-braces — the domains'
  # <hostdev managed='yes'> make libvirt unbind/bind at VM start. With the
  # nvidia module loaded for the 3050, a guest card left unclaimed would be
  # taken by it at boot.
  #
  # console=tty0 lands on the onboard ASPEED VGA since 2026-10-06: the local
  # monitor on the VGA port and the BMC's iKVM show the same picture, POST and
  # BIOS Setup included.
  # From 2026-08-17 to 10-06 the ASPEED was off the bus (jumper JPG1 on 2-3)
  # and iKVM stayed black; that is what made the blind BIOS session of
  # 2026-08-17 possible. console=ttyS1 stays as the second way in: a Linux
  # serial console renders fully over SOL, so `ipmitool ... sol activate`
  # gives a real login even if the BMC's web UI is down. NixOS auto-starts
  # serial-getty@ttyS1 from this param.
  # The NVIDIA cards this box physically holds. Order follows the consumers —
  # host, arcade1, arcade2. The onboard ASPEED is deliberately NOT listed (nor was
  # the Radeon HD 5450 it replaced): `drift-ctl gpus` (modules/drift-check.nix)
  # counts `lspci -d 10de:` only, so declaring it would make gpu-discovery
  # report a disagreement that is not one.
  #
  # `vram` is FILLED now, for all three. It had been left empty because a
  # vfio-bound card is invisible to the host it sits in; the values below were
  # read on 2026-09-17 from worker5 while it still held the lot (`nvidia-smi`
  # said 8192 / 6144 / 4096 MiB). Empty would have meant "not read", never
  # "none".
  #
  # The 8GB is a GA106 reporting 2507 with a 228e audio function (the id the
  # old 3060 used), NOT the GA107 2584 of the 6GB that left: a "3050" is not one
  # part.
  #
  # The 1650 and the 1660 are `passthrough` (2026-10-08); the RTX 3050 is the
  # host's and is not. That boolean is the gate:
  # modules/labo-gpus.nix asserts that every card marked passthrough has both
  # its ids in boot.kernelParams. Dropping the ids without flipping the flag
  # (or the reverse) fails `nix eval` in CI and comin refuses the generation —
  # so the inventory and the kernel command line cannot quietly disagree.
  labo.gpus = [
    { slot = "b4:00.0"; id = "10de:2507"; audioId = "10de:228e"; model = "RTX 3050"; die = "GA106"; vram = "8 Go"; }
    { slot = "17:00.0"; id = "10de:2188"; audioId = "10de:1aeb"; model = "GTX 1650"; die = "TU116"; vram = "4 Go"; passthrough = true; }
    { slot = "65:00.0"; id = "10de:2184"; audioId = "10de:1aeb"; model = "GTX 1660"; die = "TU116"; vram = "6 Go"; passthrough = true; }
  ];

  boot.kernelParams = [
    "intel_iommu=on" "iommu=pt"
    # The two Turing guest cards and their three other functions (1aec = USB
    # 3.1, 1aed = USB-C UCSI: labo.gpus checks only GPU + audio, these two are
    # here because the whole IOMMU group must be vfio-bound). 2507/228e — the
    # host's RTX 3050 — are deliberately absent.
    "vfio-pci.ids=10de:2188,10de:2184,10de:1aeb,10de:1aec,10de:1aed"
    "console=tty0" "console=ttyS1,115200n8"
    # No framebuffer console on the 3050 (the kiosk's card until
    # 2026-10-14): tty1..n stay on the ASPEED, the output the iKVM captures.
    "nvidia-drm.fbdev=0"
  ];

  # No forced console mode: the ast driver uses an EDID (even a forced one)
  # only when a monitor answers on DDC, and rejects the 1080p `video=` builds
  # (negative hsync) — read in drivers/gpu/drm/ast (6.18) on 2026-10-09. The
  # console stays 1024x768 until a VGA EDID emulator sits between the port and
  # the VGA switch (net-cfgs backlog).

  # The rack kiosk ran here, on the RTX 3050's HDMI as logind seat1, from
  # 2026-10-09 to 2026-10-14. It moved to its own machine, hosts/kiosque (an
  # X9SCM-F with a Radeon), so that stella's reboots and game mode no longer
  # take the rack's screen with them; the 3050 is k3s's alone again.
  #
  # The work laptop's two screens stay here: the two UGREEN 25173 capture
  # cards are plugged into stella, and their cables do not reach kiosque. Each
  # is served on 127.0.0.1 only, and kiosque forwards the two ports over SSH
  # (modules/kiosk-capture.nix). Ports = 8100 + kiosque's numpad key (6, 7).
  # By USB port, not by-id: both cards report the same serial (00000001), so
  # /dev/v4l/by-id holds a single link for the two. usb-0:6 is the card the
  # by-id link pointed to, i.e. the one face 5 showed until 2026-10-14 (now 6).
  labo.kioskCapture = {
    cards = [
      { name = "bureau"; port = 8106; device = "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:6:1.0-video-index0"; }
      { name = "bureau2"; port = 8107; device = "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:1:1.0-video-index0"; }
    ];
    # /var/lib/kiosk/tunnel/id_ed25519.pub on kiosque (generated there on
    # 2026-10-14; the private half never left it).
    clientKeys = [ "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY0000 reader@example" ];
  };

  networking.hostName = "luna";
  # Routage par source pour la patte VLAN50 : voir modules/dual-homed-routing.nix.
  labo.dualHomed = {
    enable = true;
    octet = 140;
    vlan10Network = "30-mvhost";
    vlan50Network = "25-mvhost50";
  };
  networking.useNetworkd = true;
  networking.useDHCP = false;

  # Networking mirrors bob's exactly, including the macvlan indirection.
  # WHY THE MACVLANS: this is a libvirt host, and any future guest that takes
  # a macvtap on the uplink (the gaming guests, most likely) cannot reach the
  # host stack over its own parent interface — a kernel property, not a
  # firewall or routing bug. So stella's own addresses live on macvlans over
  # the parents rather than on the parents themselves, pre-emptively, exactly
  # as bob and vega do (they learned it the hard way). The fix is needed
  # once per parent interface a guest has a macvtap on, hence both sides.
  # (Originally set up for worker5's return as a guest. worker5 was dropped
  # from the fleet in between and came back on 2026-09-14 as the GPU node, so
  # this macvlan pattern is load-bearing again — for it and for the gaming
  # guests both.)
  systemd.network = {
    enable = true;

    netdevs."10-vlan10" = {
      netdevConfig = { Name = "vlan10"; Kind = "vlan"; };
      vlanConfig.Id = 10;
    };
    netdevs."15-mvhost" = {
      netdevConfig = { Name = "mvhost"; Kind = "macvlan"; };
      macvlanConfig.Mode = "bridge";
    };
    netdevs."16-mvhost50" = {
      netdevConfig = { Name = "mvhost50"; Kind = "macvlan"; };
      macvlanConfig.Mode = "bridge";
    };

    # Untagged = VLAN50, tagged VLAN10 rides on top. NB: the interface name
    # is bob's; if the install shows stella naming its uplink differently,
    # this is the one line to correct.
    networks."10-eno2" = {
      matchConfig.Name = "eno2";
      vlan = [ "vlan10" ];
      macvlan = [ "mvhost50" ];
      networkConfig.DHCP = "no";
      linkConfig.RequiredForOnline = "no";
    };
    # VLAN50 address: address ONLY, deliberately no gateway. The dual-homing
    # rule — exactly one default route per host and it is always the VLAN10
    # one. Two default routes is the most-repeated bug class in this lab.
    networks."25-mvhost50" = {
      matchConfig.Name = "mvhost50";
      address = [ "203.0.113.140/23" ];
      networkConfig.DHCP = "no";
      linkConfig.RequiredForOnline = "no";
    };
    # vlan10 parents the macvlan and brings the link up — no IP here.
    networks."20-vlan10" = {
      matchConfig.Name = "vlan10";
      macvlan = [ "mvhost" ];
      networkConfig.DHCP = "no";
      linkConfig.RequiredForOnline = "no";
    };
    # The real host address. hex(140) = 0x8c, per the VLAN10 IPv6 convention.
    networks."30-mvhost" = {
      matchConfig.Name = "mvhost";
      address = [
        "192.0.2.140/23"
        "2001:db8:50:a::8c/64"
      ];
      routes = [ { Gateway = "192.0.2.254"; } ];
      networkConfig = { DHCP = "no"; DNS = "192.0.2.254"; IPv6AcceptRA = true; };
      domains = [ "lab.example" "example.com" "~." ];
    };
  };
  networking.search = [ "lab.example" "example.com" ];

  # k3s agent: advertise the VLAN10 address as the node IP, same as every other
  # host (the module handles server address, token, firewall). No node taint —
  # the game-mode cordon keeps new pods off during a gaming session.
  #
  # gpu=nvidia is back since 2026-10-08, with the RTX 3050 8GB (from
  # 2026-10-04 to then the card was arcade1's). --node-label only applies at
  # FIRST registration, so on the existing node it is set by hand
  # (`kubectl label node luna gpu=nvidia`); this flag is for a rebuild.
  # The card is the host's, not an arcade's: game mode no longer evicts the
  # pods that use it.
  services.k3s.extraFlags = [
    "--node-ip=192.0.2.140"
    "--node-label=gpu=nvidia"
  ];

  # GAME MODE: cordon stella while a gaming VM runs, and return it to the
  # pool when none is. This is a libvirt qemu hook, so it
  # fires no matter HOW the VM is started (Home Assistant button, `virsh
  # start`, autostart) — the on/off surface stays a dumb start/stop.
  #   - prepare: cordon only — no NEW pod is scheduled here mid-session.
  #     NO drain since 2026-10-15: the guests are 8 GB and the RAM budget
  #     holds with the running pods (see the header), and a drain would kill
  #     whatever must keep running (Frigate, once it moves here).
  #   - release (VM stopped): if no OTHER arcade VM is still running, uncordon.
  # Uses the seeded admin kubeconfig. Re-entrancy-safe: it checks for the other
  # guest via pgrep, never by calling back into libvirt from inside the hook.
  #
  # Also forces the BMC fan mode to Full Speed while a gaming VM runs. Found
  # 2026-09-02: the passed-through GPUs sit behind vfio-pci, invisible to the
  # board's own thermal zones, so the case fan curve never reacts to them —
  # the RTX 3050 was hitting 86-87C (SW Thermal Slowdown active) with the
  # only reporting case fan (FAN4) sitting at ~800 RPM under Optimal mode.
  # No room to add a dedicated fan for that slot, so brute-force the case
  # airflow instead: raw `0x30 0x45 0x01 <mode>` is the standard Supermicro
  # X9/X10/X11 fan-mode command (00=Standard 01=Full Speed 02=Optimal
  # 04=Heavy IO); verified in-band via ipmitool, FAN4 800->1700 RPM on 01.
  # Revert to Optimal (not Standard) on release to match what was observed
  # as the board's own idle default.
  virtualisation.libvirtd.hooks.qemu.gamemode = pkgs.writeShellScript "gamemode-qemu-hook" ''
    export PATH=/run/current-system/sw/bin:$PATH
    GUEST="$1"; OP="$2"
    case "$GUEST" in arcade1|arcade2) ;; *) exit 0 ;; esac
    K="k3s kubectl --kubeconfig=/etc/rancher/k3s/admin.yaml"
    IPMI="${pkgs.ipmitool}/bin/ipmitool raw 0x30 0x45 0x01"
    OTHER=$([ "$GUEST" = arcade1 ] && echo arcade2 || echo arcade1)
    case "$OP" in
      prepare)
        logger -t gamemode "$GUEST starting -> cordon luna, BMC fans full speed"
        $K cordon luna 2>&1 | logger -t gamemode
        $IPMI 0x01 2>&1 | logger -t gamemode
        ;;
      release)
        if ! pgrep -f "guest=$OTHER," >/dev/null 2>&1; then
          logger -t gamemode "$GUEST stopped, no arcade running -> uncordon luna, BMC fans optimal"
          $K uncordon luna 2>&1 | logger -t gamemode
          $IPMI 0x02 2>&1 | logger -t gamemode
        fi
        ;;
    esac
    exit 0
  '';

  users.users.ludorl82 = {
    isNormalUser = true;
    # Console password (iKVM, rack screen) = KeePass entry "Linux", asked for
    # on 2026-10-09. Only its sha-512 HASH, seeded by hand on the host (root
    # 600, never in git: the repo is published sanitized and a published hash
    # can be cracked offline). sudo does not ask for it (wheelNeedsPassword =
    # false) and SSH stays key-only. Missing file = the account stays locked.
    hashedPasswordFile = "/var/lib/secrets/ludorl82.hash";
    extraGroups = [ "wheel" "libvirtd" ];
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY0000 reader@example"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY0000 reader@example"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY0000 reader@example"
      # Home Assistant's arcade on/off key — forced to arcadeCtl, nothing else.
      ''command="${arcadeCtl}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY0000 reader@example''
    ];
  };
  security.sudo.wheelNeedsPassword = false;
  services.openssh.enable = true;

  # libvirt/qemu-kvm host: the gaming guests land here once the second GPU
  # moves across. OVMF/UEFI firmware ships by default, which the Windows
  # guests will need. NOTE: on this host the virt-secret encryption key must
  # be created with the systemd HOST key, not the TPM — Load Optimized
  # Defaults (2026-08-17) left the onboard TPM2 throwing on Esys_CreatePrimary,
  # so `virt-secret-init-encryption` (which uses --with-key=auto → TPM first)
  # SIGABRTs under its sandbox on a fresh key. The key was seeded by hand with
  # --with-key=host during the install; if it is ever regenerated, do the same
  # until the TPM is cleared/re-enabled on a physical BIOS visit.
  virtualisation.libvirtd.enable = true;
  # TPM 2.0 for win11: Windows 11 setup refuses to install without one. An
  # emulated TPM (state under /var/lib/libvirt/swtpm), unrelated to the
  # board's own TPM2 and its Esys_CreatePrimary trouble noted above.
  virtualisation.libvirtd.qemu.swtpm.enable = true;

  # coquille and win11 can live here or on bob and move between them while
  # running: `sudo vm-move <vm> <host>` (modules/vm-host.nix). win11's QEMU
  # console keeps its :5903 on whichever host runs it.
  labo.vmHost = {
    enable = true;
    alwaysOn = [ "coquille" "win11" ];
    vncProxies.win11 = 5903;
  };

  # Binding by `ids=` (not per-PCI-address driver_override) is deliberate: it
  # survives a card moving slot, which is exactly what happened on 2026-09-14.
  # The flip side is that it CANNOT distinguish two identical cards — if a
  # second GA107 3050 ever arrives it will be bound too, wanted or not, and
  # that is the day to switch to driver_override per address.
  boot.initrd.kernelModules = [ "vfio_pci" "vfio" "vfio_iommu_type1" ];
  # The Turing cards bring a USB 3.1 controller (xhci_pci) and a USB-C UCSI
  # function (i2c_nvidia_gpu), and their audio goes to snd_hda_intel: each of
  # those drivers would grab its function if it loaded first, splitting the
  # IOMMU group and making libvirt refuse the guest. vfio_pci loads in the
  # initrd above; these softdeps make sure it is there first even when a
  # driver is pulled in by udev, and that nvidia (the host's 3050) never sees
  # a guest card.
  boot.extraModprobeConfig = ''
    softdep xhci_pci pre: vfio-pci
    softdep i2c_nvidia_gpu pre: vfio-pci
    softdep snd_hda_intel pre: vfio-pci
    softdep nvidia pre: vfio-pci
  '';
  boot.blacklistedKernelModules = [ "nouveau" ];

  # --- The RTX 3050 8GB is the HOST's again (2026-10-08) --------------------
  # Same block as 2026-09-17 to 10-03, when this card first ran here (git:
  # 4c363bb^ keeps its long post-mortem of the 2026-09-14 deadlock). Short:
  # that deadlock was a br_netfilter / bridge race at boot, not nvidia's
  # (reproduced on encodeur, modules/k3s-agent.nix); br_netfilter now loads at
  # boot on every k3s node. If a boot ever wedges anyway, pick the previous
  # generation from the serial GRUB menu (`ipmitool ... sol activate`).
  #
  # No race with vfio: vfio_pci claims the guest cards' ids in the initrd,
  # before nvidia can load from the real root, so nvidia finds exactly one
  # unclaimed card — the GA106 at b4:00.0.
  #
  # `services.xserver.videoDrivers = [ "nvidia" ]` without an X server is
  # load-bearing: it is how NixOS decides the driver is installed, and
  # hardware.nvidia-container-toolkit asserts on it (an assertion only a
  # BUILT closure trips). `modesetting.enable = true` since 2026-10-09, when
  # the 3050 drove the rack kiosk's HDMI output (moved to kiosque 2026-10-14,
  # kept: harmless, and the module the kiosk needed if it ever comes back). Its
  # framebuffer console is off (nvidia-drm.fbdev=0, below), so the text
  # console stays on the ASPEED alone — the output the iKVM captures.
  #
  # A REBOOT is required after the first switch: vfio-pci.ids only changes at
  # boot, and until the module is loaded the CDI generator fails with "Driver
  # Not Loaded" and writes no spec.
  nixpkgs.config.allowUnfree = true;
  hardware.graphics.enable = true;
  services.xserver.videoDrivers = [ "nvidia" ];
  hardware.nvidia = {
    package = import ../../modules/nvidia-driver.nix {
      inherit (config.boot.kernelPackages) nvidiaPackages;
    };
    open = false;
    modesetting.enable = true;
    nvidiaSettings = false;
  };

  # CDI for k3s — encodeur's recipe (hosts/stella, ex-encodeur, has the long version):
  # the runtime binaries live in the toolkit's `tools` output, the runtime
  # needs runc on its PATH, and workloads ask for runtimeClassName nvidia-cdi.
  hardware.nvidia-container-toolkit.enable = true;
  systemd.services.k3s.path = [
    pkgs.nvidia-container-toolkit.tools
    pkgs.nvidia-container-toolkit
    pkgs.runc
  ];

  # pciutils so the next person to touch the GPUs can run lspci without
  # falling back to reading /sys by hand, which is what this change needed.
  environment.systemPackages = [ pkgs.pciutils ];

  # --- LAN/VPN-only VNC access to the arcade VMs ----------------------------
  # Each VM's QEMU VNC lives on stella's localhost with a DYNAMIC display
  # (arcade1 was :0, arcade2 :1). These socket-activated proxies expose them on
  # stella's LAN IP at FIXED ports (arcade1 -> 5901, arcade2 -> 5902) and
  # resolve the live display PER CONNECTION, so a VM restart — these are
  # on-demand — never leaves a stale port. Reachable as stella.lab.example:5901
  # / :5902; the guests also forward their own :5900 here so
  # arcade{1,2}.lab.example:5900 work too. The firewall (below) limits the source
  # to the LAN (VLAN10/50) + WireGuard, IPv4 only — these private addresses are
  # already unreachable from the internet, this is defence in depth.
  systemd.sockets.arcade1-vncproxy = {
    wantedBy = [ "sockets.target" ];
    socketConfig = { ListenStream = "192.0.2.140:5901"; Accept = true; FreeBind = true; };
  };
  systemd.sockets.arcade2-vncproxy = {
    wantedBy = [ "sockets.target" ];
    socketConfig = { ListenStream = "192.0.2.140:5902"; Accept = true; FreeBind = true; };
  };
  systemd.services."arcade1-vncproxy@".serviceConfig = {
    ExecStart = pkgs.writeShellScript "arcade1-vncproxy" ''
      d=$(${pkgs.libvirt}/bin/virsh -c qemu:///system vncdisplay arcade1 2>/dev/null | ${pkgs.gnused}/bin/sed 's/.*://')
      [ -n "$d" ] || exit 1
      exec ${pkgs.socat}/bin/socat - TCP4:127.0.0.1:$((5900 + d))
    '';
    StandardInput = "socket";
    StandardOutput = "socket";
  };
  systemd.services."arcade2-vncproxy@".serviceConfig = {
    ExecStart = pkgs.writeShellScript "arcade2-vncproxy" ''
      d=$(${pkgs.libvirt}/bin/virsh -c qemu:///system vncdisplay arcade2 2>/dev/null | ${pkgs.gnused}/bin/sed 's/.*://')
      [ -n "$d" ] || exit 1
      exec ${pkgs.socat}/bin/socat - TCP4:127.0.0.1:$((5900 + d))
    '';
    StandardInput = "socket";
    StandardOutput = "socket";
  };
  networking.firewall.extraCommands = ''
    # arcade VNC proxies: LAN (VLAN10/50) + VPN (WireGuard + IPsec mobile)
    # sources only, IPv4.
    for net in 192.0.2.0/23 203.0.113.0/23 198.18.0.0/24 198.18.1.0/24; do
      iptables -A nixos-fw -p tcp -s "$net" --dport 5901 -j nixos-fw-accept
      iptables -A nixos-fw -p tcp -s "$net" --dport 5902 -j nixos-fw-accept
    done
  '';

  system.stateVersion = "26.05";
}
