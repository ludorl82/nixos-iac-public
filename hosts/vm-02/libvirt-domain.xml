<!--
  Canonical libvirt domain definition for the vm-02 VM, which runs on
  `srv-01`. Restore with:  virsh define hosts/vm-02/libvirt-domain.xml

  This file exists because domains here are created imperatively with
  virt-install (see srv-01/configuration.nix), so NOTHING about the VM's
  hardware was captured in git - and two settings on the <interface>
  elements below are easy to lose and painful to re-diagnose. Both were
  lost once already when vm-02 was rebuilt as a NixOS VM, and had to be
  rediscovered on 2026-07-25:

    trustGuestRxFilters='yes'   - without it, macvtap never learns the
                                  guest's solicited-node multicast group,
                                  so inbound NDP for the VM's IPv6 address
                                  is silently dropped.
    <model type='virtio'/>      - REQUIRED for the above to do anything.
                                  trustGuestRxFilters only works if the NIC
                                  model reports the guest's RX filter
                                  changes to the host; virtio-net does, the
                                  e1000 emulation does NOT. With e1000 the
                                  symptom is maddening: outbound IPv6 is
                                  fine, replies to guest-initiated traffic
                                  are fine, and only *cold* inbound NDP
                                  fails (neighbour stuck INCOMPLETE), so a
                                  warm neighbour cache hides it entirely.

  Either change needs a full stop/start (virsh shutdown + virsh start), not
  a guest reboot, before the NIC re-attaches with the new attributes.

  net0 = tagged VLAN10 (parent `vlan10`) - primary, carries the default route.
  net1 = untagged VLAN50 (parent `eno1`) - secondary, address only, no gateway.

  Keep this in sync by hand after any `virsh edit`, by dumping the
  inactive config on srv-01:
    ssh srv-01 sudo virsh dumpxml [dash][dash]inactive vm-02
  (spelled out because a literal double hyphen is illegal inside an XML
  comment - it makes this very file fail to parse, which defeats the point
  of it being the recovery artifact.)
-->
<domain type='kvm'>
  <name>vm-02</name>
  <uuid>00000000-0000-0000-0000-000000000000</uuid>
  <memory unit='KiB'>4194304</memory>
  <currentMemory unit='KiB'>4194304</currentMemory>
  <vcpu placement='static'>4</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='pc-i440fx-11.0'>hvm</type>
    <firmware>
      <feature enabled='no' name='enrolled-keys'/>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <loader readonly='yes' type='pflash' format='raw'>/run/libvirt/nix-ovmf/edk2-x86_64-code.fd</loader>
    <nvram template='/run/libvirt/nix-ovmf/edk2-i386-vars.fd' templateFormat='raw' format='raw'>/var/lib/libvirt/qemu/nvram/vm-02_VARS.fd</nvram>
    <boot dev='cdrom'/>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-model' check='partial'/>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>
  <devices>
    <emulator>/run/libvirt/nix-emulators/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='/var/lib/libvirt/images/vm-02.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x04' function='0x0'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <target dev='hda' bus='ide'/>
      <readonly/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>
    <controller type='usb' index='0' model='ich9-ehci1'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x7'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci1'>
      <cp-1 startport='0'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x0' multifunction='on'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci2'>
      <cp-1 startport='2'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x1'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci3'>
      <cp-1 startport='4'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x2'/>
    </controller>
    <controller type='pci' index='0' model='pci-root'/>
    <controller type='ide' index='0'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x1'/>
    </controller>
    <interface type='direct' trustGuestRxFilters='yes'>
      <mac address='02:00:00:00:00:01'/>
      <source dev='vlan10' mode='bridge'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x0'/>
    </interface>
    <interface type='direct' trustGuestRxFilters='yes'>
      <mac address='02:00:00:00:00:01'/>
      <source dev='eno1' mode='bridge'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x06' function='0x0'/>
    </interface>
    <serial type='pty'>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <audio id='1' type='none'/>
    <memballoon model='virtio'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x05' function='0x0'/>
    </memballoon>
  </devices>
</domain>

